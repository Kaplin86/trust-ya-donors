bbcode_enabled = true
text = "While there are many ancient vases in existance, there is one specific one that you will likely be encountering the most. It dates back to 700 BCE. While we don't have any clear signals on what the vase is supposed to represent, many assume that it is meant to represent the human cycle. It features [b] 3 dinstict images, each with text underneath [/b]
		The images are as follows:
		[b] The first one, which features TWO characters. One holding a sword, and one holding a spear [/b] 
	[b] The second one, which features an animal and a character with a pitchfork [/b]
		[b] The third one, which features six characters holding hands [/b]
		All the text are sadly in a long-forgotten language."
fit_content = true
scroll_active = false

